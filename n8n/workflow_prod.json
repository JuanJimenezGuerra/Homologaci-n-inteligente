{
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "homologacion-ia",
        "options": {}
      },
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        100,
        300
      ]
    },
    {
      "parameters": {
        "batchSize": 1,
        "options": {}
      },
      "name": "Split In Batches",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 1,
      "position": [
        300,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://openrouter.ai/api/v1/chat/completions",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer {{$env.OPENROUTER_API_KEY}}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "model",
              "value": "mistralai/mistral-7b-instruct:free"
            },
            {
              "name": "messages",
              "value": "=[{\"role\": \"system\", \"content\": \"Eres un experto en Recursos Humanos especializado en homologación de cargos. Tu tarea es recibir un cargo de una empresa y compararlo con una lista maestra para encontrar el mejor match. RESPONDE SOLO EN JSON.\"}, {\"role\": \"user\", \"content\": \"Cargo Original: {{$node[\\\"Split In Batches\\\"].json[\\\"nombre\\\"]}}\\nArea: {{$node[\\\"Split In Batches\\\"].json[\\\"area\\\"]}}\\nDescripción Empresa: {{$node[\\\"Split In Batches\\\"].json[\\\"descripcion_empresa\\\"]}}\\n\\nCandidatos Maestros:\\n{{$node[\\\"Split In Batches\\\"].json[\\\"candidatos_maestros\\\"]}}\\n\\nInstrucción: Elige el cargo más similar de los Candidatos Maestros. Si ninguno se parece nada, responde status: 'SIN COINCIDENCIA'. Responde en este formato: {\\\"cargo_id\\\": {{$node[\\\"Split In Batches\\\"].json[\\\"id\\\"]}}, \\\"cargo_homologado\\\": \\\"Nombre del cargo elegido\\\", \\\"justificacion\\\": \\\"Breve explicación de por qué coinciden\\\", \\\"status\\\": \\\"homologado\\\"}\"}]"
            }
          ]
        },
        "options": {}
      },
      "name": "OpenRouter IA",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        500,
        300
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "openrouter-api",
          "name": "OpenRouter API Key"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.BACKEND_URL}}/webhook/n8n",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "results",
              "value": "=[{{$node[\"OpenRouter IA\"].json[\"choices\"][0][\"message\"][\"content\"]}}]"
            }
          ]
        },
        "options": {}
      },
      "name": "Callback Backend",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        700,
        300
      ]
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          {
            "node": "Split In Batches",
